# Test environment configuration. Consumed by docker-compose.yml and the Makefile.
# These are local-only development values, not secrets.

COMPOSE_PROJECT_NAME=fdb-profile-analyzer

# --- FoundationDB ---------------------------------------------------------
# Multi-arch image (amd64 + arm64). 7.3.x is the floor the decoder targets.
FDB_VERSION=7.3.79
# Host and container port must match: the cluster file advertises
# 127.0.0.1:<FDB_PORT>, and the host reaches it through the published port.
FDB_PORT=4500
FDB_STORAGE_ENGINE=ssd-redwood-1
# The cluster label the test bed's agent stamps on every row it ships.
FDB_CLUSTER_NAME=test
# Sample every transaction, cap the profile ring buffer at 100MB.
FDB_PROFILE_RATE=1.0
FDB_PROFILE_SIZE=100MB

# --- ClickHouse -----------------------------------------------------------
CLICKHOUSE_VERSION=26.3
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=fdb_profiles
CLICKHOUSE_USER=fdb
CLICKHOUSE_PASSWORD=fdb

# --- Grafana --------------------------------------------------------------
GRAFANA_VERSION=13.0.8
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
